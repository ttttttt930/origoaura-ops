node_modules/
dist/
*.tsbuildinfo
coverage/
.DS_Store

# 安全（SAD §11）：密钥不入仓
.env
.env.local
data/.secret
*.key
.origo-key

# 原始导出与本地 store 不进公开仓（SAD §11）
data/raw/*
!data/raw/.gitkeep
data/canonical/*
!data/canonical/.gitkeep

# 截图/录屏素材：解锁后的看板截图带着**解密后的真实经营数字**，
# 公开出去等价于绕过快照口令（ADR-06），一律不入库。
docs/*.png
docs/*.jpg
docs/*.gif
docs/*.webm

# 主数据中的商业敏感项 —— 供应商报价 / 平台扣点 / 库存 / 目标。
# 快照本身是加密的，但这几份是**明文**，且被公开仓索引后无法收回。
# 管道在本机运行，这些文件留在本地即可；新环境用同目录的 *.example.json 起步。
data/master/sku-bom.json
data/master/sku-quotes.json
data/master/platform-fees.json
data/master/inventory.json
data/master/targets.json
